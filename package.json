{
  "name": "bidpilot-cl",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Agente local-first que prepara postulaciones a licitaciones de Mercado Público (Chile).",
  "license": "MIT",
  "engines": {
    "node": ">=20.16.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "eval": "tsx packages/core/src/eval-cli.ts",
    "extract": "tsx --env-file=.env packages/core/src/extract-cli.ts",
    "ingest": "tsx --env-file=.env packages/core/src/ingest-cli.ts",
    "start": "npm run start -w @bidpilot/web",
    "dev": "npm run dev -w @bidpilot/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
